{
  "scene": "floorplan",
  "pageTitle": { "en": "Lab 05 · Part 4: Too wide: turn a block", "fr": "Lab 05 · Partie 4 : Trop large : tourner un bloc" },
  "eyebrow": { "en": "Lab 05 · B*-tree · animated lesson, part 4 of 5", "fr": "Lab 05 · Arbre B* · leçon animée, partie 4 sur 5" },
  "title": { "en": "Too wide: turn a block", "fr": "Trop large : tourner un bloc" },
  "lede": { "en": "A row of five blocks sticks out of the outline; turning one block on its side makes it fit. Click any block to try a swap, a turn or a move. <a href=\"../../index.html#video\">Back to the video parts</a>.", "fr": "Une rangée de cinq blocs dépasse du contour ; tourner un bloc sur le côté la fait tenir. Cliquez sur un bloc pour essayer un échange, une rotation ou un déplacement. <a href=\"../../index.html#video\">Retour aux parties vidéo</a>." },

  "floorplan": {
    "start": "rotate_start",
    "labels": {
      "nextDoor": { "en": "next door", "fr": "à côté" },
      "upstairs": { "en": "upstairs", "fr": "à l'étage" }
    },
    "claims": [
      { "tree": "rotate_start", "walk": "ABCDE", "pos": { "D": [7, 0], "E": [10, 0] },
        "wA": 3, "wB": 2, "wC": 2, "wD": 3, "hD": 1, "wE": 2, "bbox": [12, 3], "legal": false },
      { "tree": "rotate_after", "pos": { "D": [7, 0], "E": [8, 0] }, "wD": 1, "hD": 3,
        "bbox": [10, 3], "legal": true },
      { "tree": "golden", "bbox": [9, 3], "area": 27, "wasted": 4, "legal": true },
      { "tree": "best", "bbox": [6, 4], "area": 24, "wasted": 1, "legal": true }
    ]
  },

