    { "from": "slide:17", "to": "slide:18", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "Covered and **wasted**", "fr": "Couvertes et **perdues**" },
      "sub": { "en": "{fewer wasted squares, tighter floorplan@tighter}", "fr": "{moins de cases perdues, plan plus serré@tighter}" } },
    { "from": "@t23", "to": "slide:18", "x": 4, "y": 34, "type": "eq",
      "text": { "en": "{**23** covered@t23} {+ **4** empty@four} {= 27@wasted17}", "fr": "{**23** couvertes@t23} {+ **4** vides@four} {= 27@wasted17}" } },

    { "from": "slide:18", "to": "slide:19", "x": 2, "y": 3, "type": "headline",
