      "sub": { "en": "{9 × 4 = 36@t36} {· 13 wasted@thirteen} {· one swap, a new score@score}", "fr": "{9 × 4 = 36@t36} {· 13 perdues@thirteen} {· un échange, un nouveau score@score}" } },
    { "from": "@t27b", "to": "slide:19", "x": 2, "y": 30, "type": "thumbs",
      "items": [ { "tree": "golden", "best": "@better18", "bestLabel": { "en": "better", "fr": "meilleur" } },
