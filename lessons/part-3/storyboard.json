    { "from": "slide:16", "to": "slide:17", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "Which floorplan is **better**?", "fr": "Quel plan est le **meilleur** ?" },
      "sub": { "en": "{first tree: 9 wide, 3 tall@three16}{ = 27 squares@t27}", "fr": "{premier arbre : 9 de large, 3 de haut@three16}{ = 27 cases@t27}" } },
