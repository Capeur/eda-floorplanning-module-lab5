  "question": {
    "at": "slide:19:end+0.4",
    "text": { "en": "Every child is a left child: does this long row fit inside the outline?", "fr": "Chaque enfant est un enfant gauche : cette longue rangée tient-elle dans le contour ?" },
    "hint": { "en": "Every left child goes next door. Add up the widths of the five blocks.", "fr": "Chaque enfant gauche va à côté. Additionnez les largeurs des cinq blocs." },
    "options": [
      { "label": { "en": "Yes, it fits", "fr": "Oui, elle tient" },
        "reply": { "en": "Not quite. The widths add up: 3 + 2 + 2 + 3 + 2 = ##12##, and the outline is only 10 wide, so E sticks out. Part 4 shows it block by block.", "fr": "Pas tout à fait. Les largeurs s'additionnent : 3 + 2 + 2 + 3 + 2 = ##12##, et le contour ne fait que 10 de large : E dépasse. La partie 4 le montre bloc par bloc." } },
      { "label": { "en": "No, it sticks out", "fr": "Non, elle dépasse" },
        "reply": { "en": "Yes. The widths add up: 3 + 2 + 2 + 3 + 2 = ##12##, wider than the 10-wide outline, so E sticks out. Part 4 shows it block by block.", "fr": "Oui. Les largeurs s'additionnent : 3 + 2 + 2 + 3 + 2 = ##12##, plus que les 10 du contour : E dépasse. La partie 4 le montre bloc par bloc." } },
      { "label": { "en": "It fits exactly", "fr": "Elle tient tout juste" },
        "reply": { "en": "Close, but no: A, B, C and D already fill the 10 squares of the width, and E still needs 2 more. The row is ##12## wide. Part 4 shows it block by block.", "fr": "Presque, mais non : A, B, C et D remplissent déjà les 10 cases de large, et E en demande encore 2. La rangée fait ##12## de large. La partie 4 le montre bloc par bloc." } }
    ]
