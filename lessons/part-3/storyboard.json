  "overlays": [
    { "from": "start", "to": "slide:14", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "No: D lands **one square higher**", "fr": "Non : D arrive **une case plus haut**" },
      "sub": { "en": "{y = 2 → y = 3@higher} {· C is the root, A takes its place@takes}", "fr": "{y = 2 → y = 3@higher} {· C est la racine, A prend sa place@takes}" }, "size": 3.6 },

    { "from": "slide:14", "to": "slide:15", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "The **skyline**", "fr": "La **ligne d'horizon**" },
      "sub": { "en": "{a new block falls until it touches it@touches}", "fr": "{un nouveau bloc tombe jusqu'à la toucher@touches}" } },
    { "from": "@skyline", "to": "slide:15", "x": 60, "y": 19, "type": "term",
      "text": { "en": "Skyline", "fr": "Ligne d'horizon" },
      "sub": { "en": "the top edge of everything placed so far", "fr": "le bord supérieur de tout ce qui est déjà placé" } },

    { "from": "slide:15", "to": "slide:16", "x": 2, "y": 3, "type": "headline",
