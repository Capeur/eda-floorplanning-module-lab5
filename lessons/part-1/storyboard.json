{
  "scene": "floorplan",
  "pageTitle": { "en": "Lab 05 · Part 1: A tree is a recipe", "fr": "Lab 05 · Partie 1 : Un arbre est une recette" },
  "eyebrow": { "en": "Lab 05 · B*-tree · animated lesson, part 1 of 5", "fr": "Lab 05 · Arbre B* · leçon animée, partie 1 sur 5" },
  "title": { "en": "A tree is a recipe", "fr": "Un arbre est une recette" },
  "lede": { "en": "Five blocks, one outline, and a B*-tree that says where each block goes. Click any block to try a swap, a turn or a move. <a href=\"../../index.html#video\">Back to the video parts</a>.", "fr": "Cinq blocs, un contour, et un arbre B* qui dit où va chaque bloc. Cliquez sur un bloc pour essayer un échange, une rotation ou un déplacement. <a href=\"../../index.html#video\">Retour aux parties vidéo</a>." },

  "floorplan": {
    "start": "golden",
    "labels": {
      "nextDoor": { "en": "next door", "fr": "à côté" },
      "upstairs": { "en": "upstairs", "fr": "à l'étage" }
    },
    "claims": [
      { "tree": "golden", "walk": "ABCED", "pos": { "A": [0, 0], "B": [3, 0] }, "wA": 3, "hA": 2, "legal": true },
      { "tree": "lift", "legal": true },
      { "tree": "best", "legal": true }
    ]
  },

  "anchors": {
    "five":      { "slide": 1, "en": "five", "fr": "cinq" },
    "frame":     { "slide": 1, "en": "frame", "fr": "cadre" },
    "tree":      { "slide": 1, "en": "tree", "fr": "arbre" },
    "tree2":     { "slide": 1, "en": "tree#1", "fr": "arbre#1" },
    "find":      { "slide": 1, "en": "find", "fr": "trouverez" },
    "blocks":    { "slide": 2, "en": "blocks", "fr": "blocs" },
    "named":     { "slide": 2, "en": "named", "fr": "nommés" },
    "width":     { "slide": 2, "en": "width", "fr": "largeur" },
    "floorplan": { "slide": 3, "en": "floorplan", "fr": "plan" },
    "outline":   { "slide": 3, "en": "outline", "fr": "contour" },
    "eight":     { "slide": 3, "en": "eight", "fr": "huit" },
    "tighter":   { "slide": 3, "en": "tighter", "fr": "plus" },
    "packed":    { "slide": 3, "en": "packed", "fr": "serrés" },
    "bstar":     { "slide": 4, "en": "recipe", "fr": "recette" },
    "node":      { "slide": 4, "en": "node", "fr": "nœud" },
    "root":      { "slide": 4, "en": "root", "fr": "racine" },
    "left":      { "slide": 4, "en": "left", "fr": "gauche" },
    "right":     { "slide": 4, "en": "right", "fr": "droit" },
    "corner":    { "slide": 5, "en": "corner", "fr": "coin" },
    "x":         { "slide": 5, "en": "x", "fr": "x" },
    "y":         { "slide": 5, "en": "y", "fr": "y" },
    "next":      { "slide": 6, "en": "next door", "fr": "côté" },
    "upstairs":  { "slide": 6, "en": "upstairs", "fr": "étage" },
    "names":     { "slide": 6, "en": "names", "fr": "noms" },
    "solid":     { "slide": 6, "en": "solid", "fr": "plein" },
    "dashed":    { "slide": 6, "en": "dashed", "fr": "pointillé" },
    "three":     { "slide": 7, "en": "three", "fr": "trois" },
    "B":         { "slide": 7, "en": "B", "fr": "B" },
    "pause":     { "slide": 7, "en": "pause", "fr": "pause" }
  },

  "pausing": { "between": 0.55, "scene": 0.9, "question": 1.3, "tail": 2.0 },
  "pauses": [
    { "after": "@find", "sec": 2.0 },
    { "after": "@packed", "sec": 1.4 },
    { "after": "@corner", "sec": 0.9 },
    { "after": "@upstairs", "sec": 1.0 }
  ],

  "cameras": { "blocks": [680, 390, 560] },
  "initial": { "tree": "golden", "placed": 0, "panel": "both" },
  "timeline": [
    { "at": "@find", "tree": "best", "placed": "all" },
    { "at": "slide:2", "panel": "grid", "camera": "blocks" },
    { "at": "slide:3", "camera": "full", "tree": "lift" },
    { "at": "@packed", "tree": "best" },
    { "at": "slide:3:end+0.2", "panel": "tree" },
    { "at": "slide:4", "tree": "golden", "placed": 0 },
    { "at": "@corner", "panel": "both", "placed": 1 },
    { "at": "@pause", "panel": "grid" }
  ],

  "show": [
    { "show": "highlight", "from": "@tree2", "to": "@find", "ids": ["A", "B", "C", "D", "E"] },
    { "show": "highlight", "from": "@named", "to": "@width", "ids": ["A", "B", "C", "D", "E"] },
    { "show": "dims", "from": "@width", "to": "slide:3" },
    { "show": "wasted", "from": "@tighter", "to": "slide:4" },
    { "show": "highlight", "from": "@node", "to": "@root", "ids": ["A", "B", "C", "D", "E"] },
    { "show": "highlight", "from": "@root", "to": "@left", "ids": ["A"] },
    { "show": "highlight", "from": "@left", "to": "@right", "ids": ["B"] },
    { "show": "highlight", "from": "@right", "to": "slide:5", "ids": ["D"] },
    { "show": "coords", "from": "@corner+0.6", "to": "end", "ids": ["A"] },
    { "show": "links", "from": "@next", "to": "@upstairs", "ids": ["B"] },
    { "show": "links", "from": "@upstairs", "to": "@names", "ids": ["B", "D"] },
    { "show": "links", "from": "@names", "to": "end" },
    { "show": "highlight", "from": "@next", "to": "@upstairs", "ids": ["B"] },
    { "show": "highlight", "from": "@upstairs", "to": "@names", "ids": ["D"] },
    { "show": "dims", "from": "@three", "to": "end" },
    { "show": "highlight", "from": "@three", "to": "@B", "ids": ["A"] },
    { "show": "highlight", "from": "@B", "to": "end", "ids": ["B"] }
  ],

  "overlays": [
    { "from": "start", "to": "slide:2", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "A tree is a **recipe**", "fr": "Un arbre est une **recette**" },
      "sub": { "en": "{five blocks@five} {· one frame@frame} {· one tree@tree}", "fr": "{cinq blocs@five} {· un cadre@frame} {· un arbre@tree}" } },

    { "from": "slide:2", "to": "slide:3", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "The **blocks**", "fr": "Les **blocs**" },
      "sub": { "en": "{five of them, A to E@named} {· width × height in squares@width}", "fr": "{cinq, de A à E@named} {· largeur × hauteur en cases@width}" } },
    { "from": "@blocks", "to": "slide:3", "x": 56, "y": 4, "type": "term",
      "text": { "en": "Block", "fr": "Bloc" },
      "sub": { "en": "a large rectangular part of a chip", "fr": "une grande pièce rectangulaire d'une puce" } },

    { "from": "slide:3", "to": "slide:4", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "A **floorplan**", "fr": "Un **plan de masse**" },
      "sub": { "en": "{every block inside the outline@outline} {· 10 × 8 squares@eight}", "fr": "{chaque bloc dans le contour@outline} {· 10 × 8 cases@eight}" } },
    { "from": "@floorplan", "to": "slide:4", "x": 56, "y": 3, "type": "vocab",
      "items": [
        { "k": { "en": "Floorplan", "fr": "Plan de masse" }, "text": { "en": "where each block sits", "fr": "où se trouve chaque bloc" }, "at": "@floorplan" },
        { "k": { "en": "Outline", "fr": "Contour" }, "text": { "en": "the frame blocks stay inside", "fr": "le cadre où restent les blocs" }, "at": "@outline" }
      ] },
    { "from": "@packed", "to": "slide:4", "x": 66, "y": 33, "type": "tag",
      "text": { "en": "tighter → **smaller chip**", "fr": "plus serré → **puce plus petite**" } },

    { "from": "slide:4", "to": "slide:5", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "The **B*-tree**", "fr": "L'**arbre B***" },
      "sub": { "en": "{a recipe instead of positions@bstar}", "fr": "{une recette au lieu des positions@bstar}" } },
    { "from": "@bstar", "to": "slide:5", "x": 50, "y": 33, "type": "vocab",
      "items": [
        { "k": { "en": "B*-tree", "fr": "Arbre B*" }, "text": { "en": "says where each block goes", "fr": "dit où va chaque bloc" }, "at": "@bstar" },
        { "k": { "en": "Node", "fr": "Nœud" }, "text": { "en": "one block", "fr": "un bloc" }, "at": "@node" },
        { "k": { "en": "Root", "fr": "Racine" }, "text": { "en": "the top node, A", "fr": "le nœud du haut, A" }, "at": "@root" },
        { "k": { "en": "Children", "fr": "Enfants" }, "text": { "en": "a left child and a right child", "fr": "un enfant gauche et un enfant droit" }, "at": "@left" }
      ] },

    { "from": "slide:5", "to": "slide:6", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "Start in the **corner**", "fr": "On part du **coin**" },
      "sub": { "en": "{the root A sits at (0, 0)@corner}", "fr": "{la racine A est en (0, 0)@corner}" } },
    { "from": "@x", "to": "slide:6", "x": 56, "y": 4, "type": "tags",
      "items": [
        { "text": { "en": "**x** → squares to the right", "fr": "**x** → cases vers la droite" }, "at": "@x" },
        { "text": { "en": "**y** ↑ squares up", "fr": "**y** ↑ cases vers le haut" }, "at": "@y" }
      ] },

    { "from": "slide:6", "to": "slide:7", "x": 2, "y": 3, "type": "headline", "size": 3.6,
      "text": { "en": "Left = **next door**, right = **upstairs**", "fr": "Gauche = **à côté**, droite = **à l'étage**" },
      "sub": { "en": "{the names sound backwards@names}", "fr": "{les noms semblent inversés@names}" } },
    { "from": "@solid", "to": "slide:7", "x": 56, "y": 15, "type": "tags",
      "items": [
        { "text": { "en": "solid line = next door", "fr": "trait plein = à côté" }, "at": "@solid" },
        { "text": { "en": "dashed line = upstairs", "fr": "pointillé = à l'étage" }, "at": "@dashed" }
      ] },

    { "from": "slide:7", "to": "end", "x": 2, "y": 3, "type": "headline",
      "text": { "en": "Where does **B** go?", "fr": "Où va **B** ?" },
      "sub": { "en": "{A: 3 wide, 2 tall@three} {· B is A's left child@B}", "fr": "{A : 3 de large, 2 de haut@three} {· B est l'enfant gauche de A@B}" } },
    { "from": "@pause", "to": "end", "x": 2, "y": 30, "type": "question" }
  ],

  "question": {
    "at": "slide:7:end+0.4",
    "text": { "en": "Where does **B**'s left edge go?", "fr": "Où va le bord gauche de **B** ?" },
    "hint": { "en": "A sits at x = 0 and is 3 wide. B is its left child.", "fr": "A est en x = 0 et fait 3 de large. B est son enfant gauche." },
    "options": [
      { "label": { "en": "x = 3, against A's right side", "fr": "x = 3, contre le côté droit de A" },
        "reply": { "en": "Yes. A left child goes next door: A starts at ##0## and is ##3## wide, so B starts at x = ##3##. Part 2 places it.", "fr": "Oui. Un enfant gauche va à côté : A commence en ##0## et fait ##3## de large, donc B commence en x = ##3##. La partie 2 le pose." } },
      { "label": { "en": "x = 0, same left edge as A", "fr": "x = 0, même bord gauche que A" },
        "reply": { "en": "That is the upstairs rule, for a right child. B is a left child, so it goes next door: x = 0 + 3 = ##3##.", "fr": "Ça, c'est la règle de l'étage, pour un enfant droit. B est un enfant gauche, donc il va à côté : x = 0 + 3 = ##3##." } },
      { "label": { "en": "x = 2", "fr": "x = 2" },
        "reply": { "en": "2 is A's height, not its width. Next door means x = 0 + 3 = ##3##.", "fr": "2 est la hauteur de A, pas sa largeur. À côté veut dire x = 0 + 3 = ##3##." } }
    ]
  },
  "chapters": [
    { "at": "start", "title": { "en": "Five blocks, one tree", "fr": "Cinq blocs, un arbre" } },
    { "at": "slide:2", "title": { "en": "The blocks", "fr": "Les blocs" } },
    { "at": "slide:3", "title": { "en": "Floorplan and outline", "fr": "Plan de masse et contour" } },
    { "at": "slide:4", "title": { "en": "The B*-tree", "fr": "L'arbre B*" } },
    { "at": "slide:5", "title": { "en": "The corner", "fr": "Le coin" } },
    { "at": "slide:6", "title": { "en": "Next door and upstairs", "fr": "À côté et à l'étage" } },
    { "at": "slide:7", "title": { "en": "Pause and guess", "fr": "Pause et devinette" } }
  ],
  "bench": { "ops": ["swap", "turn", "move"] },
  "note": { "en": "Numbers come from the lab's checker (bstar_check.py --json); the engine re-packs every tree and checks them.", "fr": "Les nombres viennent du vérificateur du lab (bstar_check.py --json) ; le moteur recalcule chaque arbre et les vérifie." }
}
